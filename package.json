{
  "name": "how-do-you-feel",
  "version": "1.0.0",
  "scripts": {
    "----------------BUILD----------------": "",
    "web:start": "ng serve",
    "web:build": "ng build",
    "----------------SYNC----------------": "",
    "android:sync": "capacitor sync android",
    "----------------LINT----------------": "",
    "lint": "eslint ./src --config ./configs/eslint/eslint.config.ts",
    "stylelint": "stylelint 'src/**/*.{scss,css}' --config ./configs/stylelint/stylelint.config.js",
    "lint-staged": "lint-staged --config ./configs/lint-staged/.lintstagedrc.json",
    "----------------BUNDLE ANALYZE----------------": "",
    "preanalyze:bundle": "ng build --configuration=production --stats-json --output-hashing=none --named-chunks",
    "analyze:bundle": "esbuild-visualizer --template=treemap --metadata=./dist/how-do-you-feel/stats.json --filename=./dist/how-do-you-feel/bundle-analyze/index.html",
    "postanalyze:bundle": "mv ./dist/how-do-you-feel/stats.json ./dist/how-do-you-feel/bundle-analyze/stats.json",
    "----------------DEPS ANALYZE----------------": "",
    "analyze:deps": "madge ./src/main.ts --ts-config tsconfig.json --image ./deps/graph.png"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.0.0",
    "@angular/compiler": "21.0.0",
    "@angular/core": "21.0.0",
    "@angular/forms": "21.0.0",
    "@angular/platform-browser": "21.0.0",
    "@angular/router": "21.0.0",
    "@capacitor/android": "7.4.4",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.4.4",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/keyboard": "7.0.3",
    "@capacitor/status-bar": "7.0.3",
    "@ionic/angular": "8.7.10",
    "@ionic/storage-angular": "4.0.0",
    "date-fns": "4.1.0",
    "rxjs": "7.8.0",
    "swiper": "12.0.3",
    "tslib": "2.3.0",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@angular/build": "21.0.0",
    "@angular/cli": "21.0.0",
    "@angular/compiler-cli": "21.0.0",
    "@capacitor/cli": "7.4.4",
    "@ionic/angular-toolkit": "12.3.0",
    "angular-eslint": "21.0.1",
    "cz-conventional-changelog": "3.3.0",
    "cz-customizable": "7.5.1",
    "esbuild-visualizer": "0.7.0",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "5.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "jsdom": "27.1.0",
    "lint-staged": "16.2.7",
    "madge": "8.0.0",
    "prettier": "3.6.2",
    "stylelint": "16.26.0",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-prettier": "5.0.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.47.0",
    "vitest": "4.0.8"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./configs/commitizen/commitizen.config.js"
    }
  }
}
